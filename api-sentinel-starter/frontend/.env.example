# Development keeps requests same-origin. Vite's proxy forwards /api to FastAPI.
VITE_API_BASE_URL=/api/v1

# Used by the Vite development server only.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# For a separately deployed frontend, set this in the host's build environment.
# Example: VITE_API_BASE_URL=https://api.example.com/api/v1
